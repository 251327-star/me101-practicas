  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "ac0e4065-9a9b-48a2-988c-cc2c7e7a876c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Promedio simple:\n",
      "[[ 85  85  85  85]\n",
      " [ 85  85  85  85]\n",
      " [ 85  85 170 170]\n",
      " [ 85  85 170 170]]\n",
      "\n",
      "Luminosidad ponderada:\n",
      "[[ 76  76 149 149]\n",
      " [ 76  76 149 149]\n",
      " [ 29  29 225 225]\n",
      " [ 29  29 225 225]]\n",
      "\n",
      "Imagen binaria:\n",
      "[[  0   0 255 255]\n",
      " [  0   0 255 255]\n",
      " [  0   0 255 255]\n",
      " [  0   0 255 255]]\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x600 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Construyo la imagen de cuatro cuadrantes\n",
    "rgb_cuatro = np.zeros((4, 4, 3), dtype=np.uint8)\n",
    "\n",
    "rgb_cuatro[0:2, 0:2] = [255, 0, 0]      # Rojo\n",
    "rgb_cuatro[0:2, 2:4] = [0, 255, 0]      # Verde\n",
    "rgb_cuatro[2:4, 0:2] = [0, 0, 255]      # Azul\n",
    "rgb_cuatro[2:4, 2:4] = [255, 255, 0]    # Amarillo\n",
    "\n",
    "# Conversión por promedio simple\n",
    "promedio_cuatro = rgb_cuatro.mean(axis=2).astype(np.uint8)\n",
    "\n",
    "# Conversión por luminosidad ponderada\n",
    "luminosidad_cuatro = (\n",
    "    0.299 * rgb_cuatro[:, :, 0].astype(float)\n",
    "    + 0.587 * rgb_cuatro[:, :, 1].astype(float)\n",
    "    + 0.114 * rgb_cuatro[:, :, 2].astype(float)\n",
    ").astype(np.uint8)\n",
    "\n",
    "# Uso el mismo umbral para comparar ambas imágenes\n",
    "umbral = 100\n",
    "binaria_cuatro = (\n",
    "    (luminosidad_cuatro >= umbral).astype(np.uint8) * 255\n",
    ")\n",
    "\n",
    "print(\"Promedio simple:\")\n",
    "print(promedio_cuatro)\n",
    "\n",
    "print(\"\\nLuminosidad ponderada:\")\n",
    "print(luminosidad_cuatro)\n",
    "\n",
    "print(\"\\nImagen binaria:\")\n",
    "print(binaria_cuatro)\n",
    "\n",
    "# Comparo los tres resultados de cada imagen\n",
    "# Las variables rgb y gris_luminosidad vienen de la Tarea 2\n",
    "binaria_dos = (gris_luminosidad >= umbral).astype(np.uint8) * 255\n",
    "\n",
    "fig, ejes = plt.subplots(2, 3, figsize=(10, 6))\n",
    "\n",
    "imagenes = [\n",
    "    [rgb, gris_luminosidad, binaria_dos],\n",
    "    [rgb_cuatro, luminosidad_cuatro, binaria_cuatro]\n",
    "]\n",
    "\n",
    "titulos = [\n",
    "    [\"Dos mitades: RGB\", \"Dos mitades: grises\", \"Dos mitades: binaria\"],\n",
    "    [\"Cuatro cuadrantes: RGB\", \"Cuatro cuadrantes: grises\",\n",
    "     \"Cuatro cuadrantes: binaria\"]\n",
    "]\n",
    "\n",
    "for fila in range(2):\n",
    "    for columna in range(3):\n",
    "        if columna == 0:\n",
    "            ejes[fila, columna].imshow(imagenes[fila][columna])\n",
    "        else:\n",
    "            ejes[fila, columna].imshow(\n",
    "                imagenes[fila][columna],\n",
    "                cmap=\"gray\",\n",
    "                vmin=0,\n",
    "                vmax=255\n",
    "            )\n",
    "\n",
    "        ejes[fila, columna].set_title(titulos[fila][columna])\n",
    "        ejes[fila, columna].axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
