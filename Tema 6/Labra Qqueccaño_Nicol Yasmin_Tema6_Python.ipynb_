   "source": [
    "umbral = 100\n",
    "binaria = (gris_luminosidad >= umbral).astype(np.uint8) * 255\n",
    "\n",
    "print(binaria)\n",
    "\n",
    "plt.imshow(binaria, cmap=\"gray\", vmin=0, vmax=255)\n",
    "plt.title(f\"Binarización con umbral {umbral}\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
