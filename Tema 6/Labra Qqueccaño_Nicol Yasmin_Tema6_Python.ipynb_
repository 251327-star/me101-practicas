   "source": [
    "rgb = np.zeros((4, 4, 3), dtype=np.uint8)\n",
    "\n",
    "rgb[:, 0:2] = [255, 0, 0]   # Mitad izquierda: rojo\n",
    "rgb[:, 2:4] = [0, 255, 0]   # Mitad derecha: verde\n",
    "\n",
    "print(rgb.shape)\n",
    "print(\"Pixel [0,0]:\", rgb[0, 0])\n",
    "print(\"Pixel [0,3]:\", rgb[0, 3])\n",
    "\n",
    "plt.imshow(rgb)\n",
    "plt.title(\"Mitad roja y mitad verde\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
  },
