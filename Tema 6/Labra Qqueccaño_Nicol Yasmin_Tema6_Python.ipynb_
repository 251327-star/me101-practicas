   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Construyo una imagen de 5 filas y 5 columnas\n",
    "gris = np.tile(np.linspace(0, 255, 5, dtype=np.uint8), (5, 1))\n",
    "\n",
    "print(\"Shape:\", gris.shape)\n",
    "print(\"Tipo de dato:\", gris.dtype)\n",
    "print(\"Promedio:\", gris.mean())\n",
    "print(gris)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "5438e09e-382c-4999-839f-b343fb328f65",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 500x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(5, 4))\n",
    "plt.imshow(gris, cmap=\"gray\", vmin=0, vmax=255)\n",
    "plt.colorbar(label=\"Intensidad\")\n",
    "plt.title(\"Degradado horizontal de 5 × 5\")\n",
    "\n",
    "plt.savefig(\"gris_tema6.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  },
