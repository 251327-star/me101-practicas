   "source": [
    "gris_promedio = rgb.mean(axis=2).astype(np.uint8)\n",
    "\n",
    "gris_luminosidad = (\n",
    "    0.299 * rgb[:, :, 0].astype(float)\n",
    "    + 0.587 * rgb[:, :, 1].astype(float)\n",
    "    + 0.114 * rgb[:, :, 2].astype(float)\n",
    ").astype(np.uint8)\n",
    "\n",
    "print(\"Promedio simple:\")\n",
    "print(gris_promedio)\n",
    "\n",
    "print(\"\\nLuminosidad ponderada:\")\n",
    "print(gris_luminosidad)"
   ]
  },
