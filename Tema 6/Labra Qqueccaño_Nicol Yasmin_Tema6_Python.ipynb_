   ],
   "source": [
    "canal_r = rgb[:, :, 0]\n",
    "canal_g = rgb[:, :, 1]\n",
    "canal_b = rgb[:, :, 2]\n",
    "\n",
    "print(\"Canal rojo:\")\n",
    "print(canal_r)\n",
    "\n",
    "print(\"\\nCanal verde:\")\n",
    "print(canal_g)\n",
    "\n",
    "print(\"\\nCanal azul:\")\n",
    "print(canal_b)\n",
    "\n",
    "fig, ejes = plt.subplots(1, 3, figsize=(9, 3))\n",
    "\n",
    "for eje, canal, titulo in zip(\n",
    "    ejes,\n",
    "    [canal_r, canal_g, canal_b],\n",
    "    [\"Canal R\", \"Canal G\", \"Canal B\"]\n",
    "):\n",
    "    eje.imshow(canal, cmap=\"gray\", vmin=0, vmax=255)\n",
    "    eje.set_title(titulo)\n",
    "    eje.axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
